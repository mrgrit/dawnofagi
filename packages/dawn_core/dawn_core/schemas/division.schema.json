{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Division manifest — org/divisions/*/division.yaml",
  "type": "object",
  "required": ["id", "name", "mission", "businesses", "teams"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "name_en": { "type": "string" },
    "mission": { "type": "string", "minLength": 5 },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "businesses": { "type": "array", "items": { "type": "string" } },
    "teams": { "type": "array", "items": { "type": "string" } },
    "zone": { "enum": ["ext", "pipe", "dmz", "int", "user"] },
    "autonomy_default": { "enum": ["A0", "A1", "A2", "A3"] },
    "notes": { "type": "string" }
  }
}
