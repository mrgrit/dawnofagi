# ─────────────────────────────────────────────────────────────────────
#  .env.example — 이 파일을 `.env` 로 복사해 값을 채운다.
#
#  ⚠️ 05_conventions #1: 시크릿 하드코딩 금지.
#     실제 `.env` 는 .gitignore 되어 있고 gitleaks pre-commit 훅이 커밋을 차단한다.
#     운영에서는 .env 대신 볼트/시크릿 매니저 주입을 권장한다.
# ─────────────────────────────────────────────────────────────────────

# ── el34 인프라 (P0 헬스체크 · P3 수집 계층) ─────────────────────────
# Assessor 주소. 비우면 10.20.32.55:8000 → 127.0.0.1:9201 순으로 탐색한다.
EL34_ASSESSOR_URL=http://10.20.32.55:8000
# Assessor X-API-Key. el34 의 .env 에 있는 API_KEY 와 같은 값.
EL34_API_KEY=

# ── EG (P1) ──────────────────────────────────────────────────────────
# bastion 그래프 DB 경로 (경로 A: bastion_graph.db 확장)
EG_DB_PATH=
# EG MCP 모드
EG_MODE=

# ── 모델 (P2) ────────────────────────────────────────────────────────
# 클라우드 — L3 데이터에는 절대 사용 금지 (pol:l3-local-only)
ANTHROPIC_API_KEY=

# "로컬" 모델 = 사내 GPU 서버 (이 호스트에는 GPU 가 없다).
# VPN(GlobalProtect) 연결 후에만 도달한다 — infra/gpu/README.md 참조.
LOCAL_LLM_BASE_URL=http://211.170.162.109:11434
LOCAL_LLM_MODEL=gpt-oss:120b
# LLM-judge 전용 — 위와 **다른 모델**이어야 담합이 아니다.
LOCAL_JUDGE_MODEL=qwen3.6:35b

# VPN — GlobalProtect. ⚠️ 자격증명은 여기(.env)에만. 커밋 금지.
VPN_PORTAL=106.240.19.114
VPN_USER=
VPN_PASSWORD=

# ── 관측성 (P2/P3) ───────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAMESPACE=dawn
# OTel GenAI semantic conventions 는 experimental — 버전 pin 필수
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# ── 저장소 (CI·릴리스) ───────────────────────────────────────────────
# GitHub PAT. 절대 커밋하지 마라. 노출되면 즉시 폐기·재발급.
GITHUB_TOKEN=

# ── 테넌트 ───────────────────────────────────────────────────────────
# 자사 = 테넌트 #0. 크로스테넌트 접근은 코드 레벨에서 금지 (pol:no-cross-tenant)
TENANT_ID=0

# ── 그룹웨어 (P4) ───────────────────────────────────────────────────────
# 세션 서명 키. 비워두면 var/groupware/session.key 를 만들어 재사용한다(0600).
# 여러 대로 확장하면 여기에 32자 이상 문자열을 넣어 공유하라.
DAWN_PORTAL_SECRET=
# HTTPS 뒤에 둘 때 1 — 세션 쿠키에 Secure 플래그가 붙는다
DAWN_PORTAL_HTTPS=0
# 그룹웨어 '관제' 화면에서 여는 픽셀 오피스 주소
DAWN_OFFICE_URL=http://localhost:8800/
