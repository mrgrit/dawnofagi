    {"type": "APPLIES_TO", "from": "pol:pii-hr-fin", "to": "sec:L3"},
    {"type": "APPLIES_TO", "from": "pol:zone-gate", "to": "sec:L2"},
    {"type": "APPLIES_TO", "from": "pol:zone-gate", "to": "sec:L3"},
    {"type": "APPLIES_TO", "from": "pol:autonomy-gate", "to": "sec:L2"},
    {"type": "APPLIES_TO", "from": "pol:autonomy-gate", "to": "sec:L3"},
    {"type": "APPLIES_TO", "from": "pol:human-oversight", "to": "sec:L2"},
