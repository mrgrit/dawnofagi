{
  "_comment": "EL34 전사 EG 시드 #2 — 규정. statement=사람이 읽는 규정, rule=판정 의사코드, enforcement=게이트 동작. skill_preview 위험도와 결합해 실제 게이트 결정.",
  "_meta": {"created_by": "founder", "seed": "02_policies"},

  "Policy": [
    {
      "id": "pol:no-cross-tenant",
      "statement": "한 고객 테넌트의 데이터에 다른 테넌트의 에이전트가 접근할 수 없다.",
      "rule": "task.tenant != asset.tenant => block",
      "category": "security", "severity": "critical", "enforcement": "block",
      "source_ref": "멀티테넌트 격리 원칙"
    },
    {
      "id": "pol:irreversible-hitl",
      "statement": "비가역 행동(결제·발송·삭제·배포)은 사전 인간 승인을 받아야 한다.",
      "rule": "asset.irreversibility in ['irreversible','execute'] AND action.destructive => require_hitl",
      "category": "security", "severity": "high", "enforcement": "require_hitl",
      "source_ref": "심각도 매트릭스(비가역성×영향범위)"
    },
    {
      "id": "pol:l3-local-only",
      "statement": "극비(L3) 데이터는 로컬 모델로만 처리한다. 클라우드 모델 전송 금지.",
      "rule": "asset.sec_rank == 3 AND model.cost_tier != 'local' => block",
      "category": "privacy", "severity": "critical", "enforcement": "block",
      "source_ref": "데이터주권·개인정보"
    },
    {
      "id": "pol:pii-hr-fin",
      "statement": "인사·재무의 개인정보/급여 데이터 접근은 항상 기록하고 인간 게이트를 건다.",
      "rule": "asset.owner_org in ['org:hr','org:fin'] AND asset.kind=='data' => require_hitl AND log",
      "category": "hr", "severity": "high", "enforcement": "require_hitl",
      "source_ref": "개인정보보호"
    },
    {
      "id": "pol:zone-gate",
      "statement": "제한(dmz)·통제(int) 존 진입은 pipe 게이트(fw/ips)를 통과해야 하며 검사 이벤트를 남긴다.",
      "rule": "asset.zone in ['zone:dmz','zone:int'] => must_pass('zone:pipe') AND log",
      "category": "security", "severity": "high", "enforcement": "log_only",
      "source_ref": "el34 4-tier 세그먼테이션"
    },
    {
      "id": "pol:autonomy-gate",
      "statement": "에이전트의 자율화 등급이 자산 민감도에 못 미치면 인간 게이트를 건다.",
      "rule": "org.autonomy_level < asset.sec_rank => require_hitl",
      "category": "security", "severity": "medium", "enforcement": "require_hitl",
      "source_ref": "자율화 사다리 A0~A3"
    },
    {
      "id": "pol:human-oversight",
      "statement": "고위험 판단에는 실질적 인간 감독이 가능해야 한다(형식적 승인 금지).",
      "rule": "action.high_risk => provide_context_for_review AND allow_override",
      "category": "compliance", "severity": "high", "enforcement": "require_hitl",
      "source_ref": "EU AI Act Art.14 (인간 감독)"
    },
    {
      "id": "pol:auditable-logging",
      "statement": "모든 AI 지원 의사결정은 사후 재구성 가능한 수준으로 로깅한다.",
      "rule": "always => record(prompt, plan, tool_io, result)",
      "category": "compliance", "severity": "high", "enforcement": "log_only",
      "source_ref": "EU AI Act Art.12 (로깅)"
    },
    {
      "id": "pol:no-malicious-security",
      "statement": "오펜시브팀의 공격 시뮬레이션은 el34 취약 웹 대상에 한정하며 실 고객 자산 금지.",
      "rule": "task.org=='org:ccc' AND action.offensive AND asset.zone != 'zone:int' => block",
      "category": "security", "severity": "critical", "enforcement": "block",
      "source_ref": "레드팀 스코프 제한"
    },
    {
      "id": "pol:quality-groundedness",
      "statement": "고객 대면 산출물은 근거(출처)를 첨부하고 할루시네이션 평가를 통과해야 한다.",
      "rule": "output.customer_facing AND groundedness_score < threshold => require_review",
      "category": "quality", "severity": "medium", "enforcement": "warn",
      "source_ref": "AOC 품질 인시던트 정의"
    },
    {
      "id": "pol:financial-approval",
      "statement": "일정 금액 이상의 경제적 거래는 인간 승인을 받는다.",
      "rule": "action.financial AND amount >= threshold => require_hitl",
      "category": "financial", "severity": "high", "enforcement": "require_hitl",
      "source_ref": "Visibility into AI Agents (고영향 행동 게이트)"
    }
  ],

  "edges": [
