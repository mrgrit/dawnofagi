    {"type": "APPLIES_TO", "from": "pol:auditable-logging", "to": "sec:L2"},
    {"type": "APPLIES_TO", "from": "pol:auditable-logging", "to": "sec:L3"},
    {"type": "APPLIES_TO", "from": "pol:no-malicious-security", "to": "sec:L3"},
    {"type": "APPLIES_TO", "from": "pol:quality-groundedness", "to": "sec:L1"},
